# ─── Required ────────────────────────────────────────────────────────────────

# LLM provider (groq | gemini | anthropic). On a rate limit the app walks every
# model in the chain below, then the other providers — free tiers meter tokens
# per model, so this multiplies the usable free quota.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model fallback chains, best quality first (comma-separated, optional)
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

LLM_TIMEOUT_SEC=90        # a hung provider would otherwise stall a whole run
LLM_MAX_TOKENS=4096       # a tailored resume runs well past 2048

# Local Mongo (docker compose up -d mongo), or your own Atlas connection string
MONGODB_URI=mongodb://localhost:27017/jobhunt

# Used on application forms
USER_FIRST_NAME=
USER_LAST_NAME=
MY_EMAIL=
MY_PHONE=

# ─── Optional: alerts ────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Optional: auto-apply ────────────────────────────────────────────────────
# No platform passwords are needed or stored. You sign in by hand once per
# session (Settings -> Login) and the browser profile keeps the session.

# APPLY_HEADLESS=1        # headless breaks manual CAPTCHA — leave unset
# APPLY_DRY_RUN=1         # fill forms and screenshot, but never submit
APPLY_HUMAN_TIMEOUT=300   # seconds to wait for you to clear a CAPTCHA
LOGIN_TIMEOUT=420         # seconds to wait for you to finish signing in
ALERT_COOLDOWN_SEC=900    # min gap between "solve this CAPTCHA" alerts
# ─── Optional: answer screening questions by replying to email ───────────────
# When the agent hits a screening question your profile and resume can't answer,
# it emails you the question and defers the job. You can always answer in
# Setup > Saved answers. Fill these in as well and you can just reply to the
# email instead — the backend polls the mailbox, matches the [JHQ:xxxx] code in
# the subject, and takes the first line of your reply as the answer.
#
# Gmail needs an App Password (Google Account > Security > 2-Step Verification >
# App passwords), NOT your normal password. Create it yourself; nothing in this
# project asks for it interactively. Leave these blank to keep polling off.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=mukulmokkapati@gmail.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_POLL_MINUTES=5

# BROWSER_PROFILE_DIR=    # defaults to backend/.browser_profiles

# Autonomous apply cycle (off unless AUTO_APPLY_ENABLED is set)
# AUTO_APPLY_ENABLED=1
AUTO_APPLY_MIN_SCORE=70
AUTO_APPLY_DAILY_CAP=20
AUTO_APPLY_PER_RUN=5
AUTO_APPLY_INTERVAL_MIN=60
AUTO_APPLY_REGION=india
AUTO_APPLY_DELAY_MIN_SEC=20   # randomised gap between two applications
AUTO_APPLY_DELAY_MAX_SEC=40

# How many years beyond your own experience a posting may demand before
# auto-apply refuses it. Your years come from Setup > You. Postings inflate, so
# a small stretch is worth a shot; a 10-year role is somebody else's job.
APPLY_YEARS_STRETCH=2

# ─── Optional: scraping & scoring ────────────────────────────────────────────

# NAUKRI_DISABLED=1       # skip Naukri (it needs a headed browser + local IP)
SCRAPE_CHALLENGE_TIMEOUT=180  # seconds to wait for you to clear a scraper bot check
SCORE_DELAY_SEC=4         # pace between scoring calls (free tiers are ~15/min)
SCORE_PER_RUN=60          # max jobs scored per run
SCORE_MAX_BACKOFFS=3      # pause the run after this many rate-limit backoffs

# ─── Optional: alerts on/off ─────────────────────────────────────────────────
# Also settable from Setup -> Agent rules, which overrides these.

ALERTS_ENABLED=1
SMS_ALERTS_ENABLED=1

# ─── App ─────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000

# Comma-separated allowlist for browser requests. Defaults to FRONTEND_URL plus
# the usual Vite ports; set explicitly if you serve the UI from anywhere else.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Which day the daily apply cap resets on. UTC midnight is 05:30 IST, so a
# morning's applications were counted against the previous day's budget.
APP_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO            # DEBUG to see every scheduler and apply decision
