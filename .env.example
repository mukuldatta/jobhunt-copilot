# ─── Required ────────────────────────────────────────────────────────────────

# LLM provider (groq | gemini | anthropic). Falls back to the others on failure.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local Mongo (docker compose up -d mongo), or your own Atlas connection string
MONGODB_URI=mongodb://localhost:27017/jobhunt

# Used on application forms
USER_FIRST_NAME=
USER_LAST_NAME=
MY_EMAIL=
MY_PHONE=

# ─── Optional: alerts ────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Optional: auto-apply ────────────────────────────────────────────────────
# No platform passwords are needed or stored. You sign in by hand once per
# session (Settings -> Login) and the browser profile keeps the session.

# APPLY_HEADLESS=1        # headless breaks manual CAPTCHA — leave unset
# APPLY_DRY_RUN=1         # fill forms and screenshot, but never submit
APPLY_HUMAN_TIMEOUT=300   # seconds to wait for you to clear a CAPTCHA
LOGIN_TIMEOUT=420         # seconds to wait for you to finish signing in
# BROWSER_PROFILE_DIR=    # defaults to backend/.browser_profiles

# Autonomous apply cycle (off unless AUTO_APPLY_ENABLED is set)
# AUTO_APPLY_ENABLED=1
AUTO_APPLY_MIN_SCORE=70
AUTO_APPLY_DAILY_CAP=20
AUTO_APPLY_PER_RUN=5
AUTO_APPLY_INTERVAL_MIN=60
AUTO_APPLY_REGION=india

# ─── Optional: scraping & scoring ────────────────────────────────────────────

# NAUKRI_DISABLED=1       # skip Naukri (it needs a headed browser + local IP)
SCORE_DELAY_SEC=4         # pace between scoring calls (free tiers are ~15/min)
SCORE_PER_RUN=60          # max jobs scored per run
SCORE_MAX_BACKOFFS=3      # pause the run after this many rate-limit backoffs
# GEMINI_MODEL=gemini-flash-latest

# ─── App ─────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
